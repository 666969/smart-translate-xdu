OPENAI_API_KEY=your_deepseek_api_key
OPENAI_MODEL=deepseek-flash
OPENAI_MODEL_FLASH=deepseek-flash
OPENAI_MODEL_PRO=deepseek-v4-pro
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TIMEOUT_MS=180000

# DeepSeek does not provide the /audio/transcriptions endpoint used by tab-audio
# transcription. Configure a separate OpenAI-compatible speech-to-text service
# only if that feature is needed.
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_MODEL=whisper-1

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
